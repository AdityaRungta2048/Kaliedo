{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "credentialsSource": "remote",
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "credentialsSource": "remote",
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": { "production": {} }
}
